{
  "name": "exES",
  "manifest_version": 3,
  "version": "1.1.2",
  "description": "18歳以上の方向け。ErogameScapeの作品ページに通販サイトの価格と過去のキャンペーンを表示します。",
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://erogamescape.dyndns.org/*", "*://erogamescape.org/*"],
      "js": ["content_scripts.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://erogamescape.dyndns.org/*",
    "*://erogamescape.org/*",
    "*://*.amazon.jp/*",
    "*://*.amazon.co.jp/*",
    "*://*.getchu.com/*",
    "*://*.sofmap.com/*",
    "*://*.suruga-ya.jp/*",
    "*://*.dmm.co.jp/*",
    "*://*.dlsite.com/*"
  ]
}
